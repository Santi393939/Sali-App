# Copy to .env.local (never commit .env.local) and fill in from
# Supabase → Project Settings → API Keys. Both values are public by design:
# they ship inside the app, and row-level security protects the data.
# Never put the database password or a secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
